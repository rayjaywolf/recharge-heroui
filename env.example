# Copy to .env and fill in values:
#   cp env.example .env

# Database (required)
DATABASE_URL="postgresql://user:password@localhost:5432/recharge"

# Auth (required)
BETTER_AUTH_SECRET="generate-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Recharge providers (optional — only needed for live gateways)
A1TOPUP_USERNAME=
A1TOPUP_PASSWORD=
REALROBO_API_TOKEN=
MROBOTICS_API_TOKEN=
