{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "dev:bun": "bun run --hot src/index.ts",
    "start:bun": "bun src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/db": "workspace:*",
    "@repo/server": "workspace:*",
    "@repo/shared": "workspace:*",
    "better-auth": "^1.5.6",
    "drizzle-orm": "^0.44.2",
    "hono": "^4.7.4"
  },
  "devDependencies": {
    "@hono/node-server": "^1.14.3",
    "@types/bun": "latest",
    "@types/node": "^20",
    "dotenv": "^17.4.2",
    "tsx": "^4.19.4",
    "typescript": "^5"
  }
}
